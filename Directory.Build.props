<Project>
  <!--
    Single source of truth for the product version (semver: major.minor.patch).
    All .NET projects inherit this automatically.
    AssemblyVersion/FileVersion are auto-derived (x.y.z → x.y.z.0).
    Build scripts append .0 when passing to WiX/MSIX (which require 4-part versions).
  -->
  <PropertyGroup>
    <Version>1.1.0</Version>
  </PropertyGroup>
</Project>
