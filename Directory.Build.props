<Project>
  <!--
    Single source of truth for the product version.
    All .NET projects (Core, Console, TrayApp, Tests, WidgetProvider) inherit these.
    The release workflow bumps the version HERE; build scripts pass it to WiX/MSIX.
  -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
  </PropertyGroup>
</Project>
